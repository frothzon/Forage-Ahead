{
  "_guide": {
    "overview": "Drop raw audio files (.wav, .mp3, .flac, .ogg, .m4a) into music/raw/<trackId>.<ext> (or set an explicit 'source' path relative to project root or music/raw/), then run `npm.cmd run prepare-music`.",
    "inspectTool": "Run `node scripts/prepare-music.mjs --inspect <path-to-audio>` to measure duration, mean/max volume, and get suggested chorus/loop timestamps.",
    "singleTrack": "Run `node scripts/prepare-music.mjs --track mus_overworld_grass` to process just one track quickly.",
    "extractChorus": "Set `trimStartSec` and `trimEndSec` (in seconds) to isolate a chorus or best segment from a longer song before mastering and loop-baking.",
    "introToLoop": "Set `loopStartSec` (relative to the trimmed audio) to preserve a non-repeating intro before the looping body. Set `loopEndSec` (or null for end of file) to define the loop end.",
    "seamlessLoopBaking": "Set `crossfadeLoopSec` (e.g. 1.5) on looping tracks (`stinger: false`). The pipeline overlaps and equal-power crossfades the last `crossfadeLoopSec` of the loop body into the start of the loop body so tracks repeat with zero click/pop and continuous reverb."
  },
